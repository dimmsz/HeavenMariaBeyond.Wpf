<UserControl
    x:Class="HeavenMaria.Wpf.Views.SelectMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:HeavenMaria.Wpf.Converters"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <converters:GirlNameTrimer x:Key="GirlNameTrimer" />
    </UserControl.Resources>

    <Grid>
        <xctk:CheckListBox
            Height="460"
            Margin="10,0,10,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontSize="16"
            ItemSelectionChanged="GirlSelectionChanged"
            ItemsSource="{Binding Girls}"
            SelectedItemsOverride="{Binding SelectedGirls}">
            <xctk:CheckListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource GirlNameTrimer}}" />
                    </Grid>
                </DataTemplate>
            </xctk:CheckListBox.ItemTemplate>
            <xctk:CheckListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding SelectAllGirlsCommand}" Header="すべて選択" />
                    <MenuItem Command="{Binding DeSelectAllGirlsCommand}" Header="すべての選択を解除" />
                    <Separator />
                    <MenuItem Command="{Binding ExitSelectModeCommand}" Header="セレクトモードから抜ける" />
                </ContextMenu>
            </xctk:CheckListBox.ContextMenu>
        </xctk:CheckListBox>
    </Grid>

</UserControl>
