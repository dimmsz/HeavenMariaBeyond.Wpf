<UserControl
    x:Class="HeavenMariaBeyond.Wpf.Views.SelectMode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:HeavenMariaBeyond.Wpf.Converters"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <converters:GirlNameTrimer x:Key="GirlNameTrimer" />
    </UserControl.Resources>

    <DockPanel>
        <TextBlock
            DockPanel.Dock="Bottom"
            Margin="10,0,10,10"
            Style="{StaticResource OperationErrorText}"
            Text="{Binding ErrorMessage}" />
        <ListBox
            Height="460"
            Margin="10,0,10,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontSize="16"
            ItemsSource="{Binding Girls}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Content="{Binding DisplayName, Converter={StaticResource GirlNameTrimer}}"
                        IsChecked="{Binding Hidden, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Command="{Binding SelectAllGirlsCommand}" Header="すべて選択" />
                    <MenuItem Command="{Binding DeSelectAllGirlsCommand}" Header="すべての選択を解除" />
                    <Separator />
                    <MenuItem Command="{Binding ExitSelectModeCommand}" Header="セレクトモードから抜ける" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>

</UserControl>
